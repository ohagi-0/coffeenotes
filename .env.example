# ---- ブラウザに出してよい変数（NEXT_PUBLIC_ 接頭辞のみ）----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# /api/* を絶対 URL で呼ぶための基点（ネイティブ化のため必須）。本番: https://coffee-notes.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100
# 地図の描画元 osm | google（既定 osm。切り替えは ADR 0011 / #40）。google のとき下の 2 つが必須
NEXT_PUBLIC_MAP_PROVIDER=osm
# Google Maps 用のブラウザ鍵（Maps JavaScript API のみ・HTTP リファラー制限）と Map ID
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ---- サーバー専用（src/app/api/ と Server Actions の中でしか参照しない）----
SUPABASE_SERVICE_ROLE_KEY=
# claude | none（none は OCR を無効化。開発時の費用節約）
OCR_PROVIDER=none
ANTHROPIC_API_KEY=
# nominatim | google
GEO_PROVIDER=nominatim
# GEO_PROVIDER=google のときのみ必須。サーバー鍵（Places API (New) のみに制限）
GOOGLE_MAPS_API_KEY=
CRON_SECRET=                      # サーバーのみ。/api/ocr/warm（OCR のウォームアップ）を叩く GitHub Actions と共有する 16 文字以上のランダム文字列

# ---- ローカル Supabase（supabase/config.toml の env() 参照）。`supabase start` 時に読まれる ----
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---- E2E（Playwright）。無ければログインが要るテストは skip される ----
# パスワードでログインするテスト用ユーザー。SUPABASE_SERVICE_ROLE_KEY があれば global-setup が自動で作る。
# 無ければダッシュボード（Authentication → Users → Add user）で作ってメール確認済みにする
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
