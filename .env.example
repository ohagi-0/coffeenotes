# ---- ブラウザに出してよい変数（NEXT_PUBLIC_ 接頭辞のみ）----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# /api/* を絶対 URL で呼ぶための基点（ネイティブ化のため必須）。本番: https://coffeenotes-red.vercel.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100

# ---- サーバー専用（src/app/api/ と Server Actions の中でしか参照しない）----
SUPABASE_SERVICE_ROLE_KEY=
# claude | none（none は OCR を無効化。開発時の費用節約）
OCR_PROVIDER=none
ANTHROPIC_API_KEY=
# nominatim | google
GEO_PROVIDER=nominatim
# GEO_PROVIDER=google のときのみ
GOOGLE_MAPS_API_KEY=

# ---- ローカル Supabase（supabase/config.toml の env() 参照）。`supabase start` 時に読まれる ----
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
